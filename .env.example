# Server-only values. Fill these in .env.local, never commit real credentials.
OPENAI_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_INTERVIEW_REASONING_EFFORT=low
# Optional separate grader; defaults to OPENAI_MODEL when blank.
OPENAI_SCORECARD_MODEL=gpt-6.1-sol
OPENAI_SCORECARD_REASONING_EFFORT=high

# Local development only: fail the first model generation attempt per chat request.
# The automatic retry then runs normally. Ignored in production and private beta.
INTELIPREP_TEST_MODEL_503_ONCE=

# Keep this stable across deployments. Generate locally: openssl rand -hex 32
# Protects browser resume tokens and hashes rate-limit identities.
INTERVIEW_RESUME_SECRET=

# Required on Vercel. Use the REST URL/token, not a redis:// connection string.
# Native Vercel Upstash installations can supply KV_REST_API_URL/TOKEN instead.
# If setting UPSTASH_REDIS_REST_* explicitly, set both values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Leave blank locally; use beta to test cloud safeguards.
# Vercel Production requires production to opt in; keep it Production-scoped.
INTELIPREP_ENV=

# Public client configuration. These two values are intended for the browser.
# Use a publishable (sb_publishable_...) key, never a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the 1-minute test option in the practice brief (leave off for beta users).
NEXT_PUBLIC_ENABLE_TEST_INTERVIEWS=0

# Local development only: set to on to exercise start quotas. Deployed limits always apply.
INTELIPREP_DEV_START_LIMITS=off

# Private read-only admin; exact Supabase Auth user ID, never a public browser variable.
ADMIN_USER_ID=
# Optional comma-separated Supabase user IDs excluded from reporting by default.
ADMIN_TEST_USER_IDS=
# Server-only Supabase Postgres URI. URL-encode its password and quote this value.
SUPABASE_CONNECTION_STRING=
# Optional complete model rate map (USD per million tokens). Defaults cover GPT-4o.
# AI_MODEL_RATES_USD_PER_MILLION={"my-model":{"input":2.5,"cached":1.25,"output":10}}
